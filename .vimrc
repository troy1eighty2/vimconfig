" header stuff
syntax on
set fileformat=unix
set encoding=UTF-8
set noswapfile
set clipboard=unnamedplus
set termguicolors
set mouse=a

" styling
set relativenumber
set cursorline
set scrolloff=10
set signcolumn=yes
colorscheme blue

" tabs
set tabstop=2
set softtabstop=2
set shiftwidth=2
set autoindent
set smartindent
set smarttab
set expandtab
set nowrap

" case
set smartcase
set ignorecase
set incsearch
set hlsearch

" column for line length
set colorcolumn=80

" status/cmd
set showcmd
set wildmenu
set laststatus=2
set confirm
set title

" netrw
"let g:netrw_liststyle = 4
let g:netrw_winsize = 20
"let g:netrw_clipboard = 0
"let g:netrw_fastbrowse = 2
let g:netrw_banner = 0
"hi! link netrwMarkFile Search

